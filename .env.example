# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Tham số thuật toán và tên model nằm trong config.yaml, không nằm ở đây.

# ---------- LLM provider: chỉ dùng OpenAI (LiteLLM đọc trực tiếp biến này) ----------
OPENAI_API_KEY=

# ---------- PostgreSQL ----------
POSTGRES_USER=ragquiz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragquiz
POSTGRES_PORT=5432
# Chạy API ngoài Docker dùng localhost; docker-compose tự ghi đè host thành "db".
DATABASE_URL=postgresql+psycopg://ragquiz:change-me@localhost:5432/ragquiz

# ---------- Backend ----------
CONFIG_PATH=config.yaml
DATA_DIR=data
MAX_UPLOAD_MB=50
# Windows (chạy ngoài Docker): C:/Program Files/LibreOffice/program/soffice.exe
SOFFICE_BIN=soffice
LOG_LEVEL=INFO

# ---------- Model local (bge-m3, reranker) ----------
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
# Thư mục cache model HuggingFace (~2,3 GB cho bge-m3)
HF_HOME=.cache/huggingface

# ---------- Frontend ----------
API_BASE_URL=http://localhost:8000
# Địa chỉ API mà trình duyệt truy cập được (ảnh slide). Mặc định bằng API_BASE_URL.
PUBLIC_API_URL=http://localhost:8000
