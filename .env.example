# Sao chép thành .env rồi điền giá trị. KHÔNG commit file .env.
# Tham số thuật toán và tên model nằm trong config.yaml, không nằm ở đây.

# ---------- LLM provider: chỉ dùng OpenAI (LiteLLM đọc trực tiếp biến này) ----------
OPENAI_API_KEY=

# ---------- PostgreSQL ----------
POSTGRES_USER=ragquiz
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragquiz
POSTGRES_PORT=5432
# Chạy API ngoài Docker dùng localhost; docker-compose tự ghi đè host thành "db".
DATABASE_URL=postgresql+psycopg://ragquiz:change-me@localhost:5432/ragquiz

# ---------- Backend ----------
CONFIG_PATH=config.yaml
DATA_DIR=data
MAX_UPLOAD_MB=50
# Windows (chạy ngoài Docker): C:/Program Files/LibreOffice/program/soffice.exe
SOFFICE_BIN=soffice
LOG_LEVEL=INFO

# ---------- Model local (bge-m3, reranker) ----------
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
# Thư mục cache model HuggingFace (~2,3 GB cho bge-m3)
HF_HOME=.cache/huggingface

# ---------- Đăng nhập Google (chỉ tài khoản @ictu.edu.vn) ----------
# Lấy ở Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI khai báo: <PUBLIC_BASE_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=ictu.edu.vn
# Email quản trị (được tải slide, xóa, sinh thêm câu hỏi), cách nhau bởi dấu phẩy
ADMIN_EMAILS=
# Địa chỉ trình duyệt mở giao diện mới (qua nginx). Google chỉ cho http với localhost; máy khác phải dùng https.
PUBLIC_BASE_URL=http://localhost:8080
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true khi chạy https; false khi thử ở http://localhost
COOKIE_SECURE=false
# Khi chạy bằng Docker, docker-compose.yml luôn đặt AUTH_REQUIRED=true (bắt buộc đăng nhập Google).
# Giá trị ở đây chỉ dùng khi chạy API ngoài Docker.
AUTH_REQUIRED=true
# Hạn mức slide sinh viên tự tải (mỗi bài đều gọi LLM sinh câu hỏi): số bài tối đa, số bài xử lý cùng lúc
STUDENT_MAX_DOCS=10
STUDENT_MAX_PROCESSING=1

# ---------- Mở ra Internet bằng Cloudflare Tunnel (tuỳ chọn, xem docs/huong-dan-trien-khai.md) ----------
CLOUDFLARE_TUNNEL_TOKEN=
