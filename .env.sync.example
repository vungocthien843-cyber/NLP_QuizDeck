# Cho máy worker (tools/worker.py) và tools/sync_to_cloud.py. Copy thành .env.sync, KHÔNG commit, KHÔNG gửi qua chat/email.

# Supabase: chuỗi "Session pooler" (cổng 5432) trong nút Connect của dự án, không dùng transaction pooler (6543)
CLOUD_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → Secret key (sb_secret_...)
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=slides

# Chỉ cần khi chạy tools/sync_to_cloud.py trực tiếp trên máy (ngoài Docker). Service worker tự đặt hai biến này.
LOCAL_DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
LOCAL_DATA_DIR=D:/Project_NLP/data

# Tuỳ chọn cho worker
# WORKER_ID=may-gpu-phong-lab        # tên hiện trong log và bảng worker_heartbeats (mặc định: tên máy)
# WORKER_MAX_PAGES=60                # PDF dài hơn sẽ bị từ chối (giới hạn chi phí OpenAI)
